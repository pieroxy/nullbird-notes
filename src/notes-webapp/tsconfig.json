{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "removeComments": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "newLine": "LF",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "bin/ts/",
    "rootDir": "src/ts/",
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "src/ts/**/*.ts"
  ]
}
